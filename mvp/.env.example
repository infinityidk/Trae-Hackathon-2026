# 橙光随手查 MVP 环境变量示例
# 复制为 .env 后填写；.env 不会进入 Git。所有模型调用只在服务端发起。

# 服务监听端口（默认 8080，固定监听 0.0.0.0 供局域网手机访问）
PORT=8080

# ===== 模型适配器（OpenAI 兼容 Chat Completions，例如 DeepSeek）=====
# 不配置时自动进入“演示案例 + 人工记录”模式，不会影响其他功能。

# 接口地址，例如 DeepSeek：https://api.deepseek.com
MODEL_BASE_URL=

# 模型名称，例如：deepseek-chat
MODEL_NAME=

# API Key（仅存在于服务端环境变量，切勿写入前端或日志）
MODEL_API_KEY=

# 该模型是否支持图片输入：true=视觉模型，false=仅文本，auto=按仅文本处理（未确认能力不假定支持图片）
MODEL_VISION=auto

# 请求超时毫秒数（默认 20000）
MODEL_TIMEOUT_MS=20000
